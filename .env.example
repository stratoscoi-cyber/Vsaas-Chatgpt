# Copy to .env and adjust. docker-compose reads this automatically.

# PostGIS password (shared by the per-service databases)
POSTGRES_PASSWORD=postgres

# Per-service DB DSNs are set in docker-compose. For local (non-Docker) runs,
# leave DATABASE_URL unset to use a local SQLite file per service (zero infra).
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/wfaas

# Shared cache. Unset -> in-memory cache per process.
# REDIS_URL=redis://localhost:6379/0

# Routing engine. Unset -> TRAAS uses the offline straight-line fallback.
# VALHALLA_URL=http://localhost:8002/route

# Weather provider (Open-Meteo, no key required)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Security & limits (apply to all services) -------------------------------
AUTH_ENABLED=false
# Comma-separated API keys accepted via X-API-Key or Authorization: Bearer
API_KEYS=
RATE_LIMIT_PER_MINUTE=0

# --- WFAAS background monitoring ---------------------------------------------
MONITOR_ENABLED=false
MONITOR_INTERVAL_MINUTES=30
# NOTIFICATIONS_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@prisamove.example
# SMTP_USE_TLS=true

# --- Optional external AI endpoints (no fabricated output if unset) ----------
# DRONE_AI_ENDPOINT=http://model-service/analyze        # drone crop-health inference
# HAGGLE_AI_ENDPOINT=http://model-service/haggle        # LGaaS haggling message LLM
